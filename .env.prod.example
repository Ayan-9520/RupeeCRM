# Copy to .env on the VPS (same folder as docker-compose.prod.yml).
# Use letters and numbers only for the password (it goes inside a URL).
POSTGRES_PASSWORD=change-me

# Docker network of the Caddy that owns ports 80/443 (kuberone-vps-caddy).
EDGE_NETWORK=change-me

# Baked into the CRM frontend at build time.
VITE_API_URL=https://crm.rupeedial.com
VITE_PUBLIC_SITE_URL=https://rupeedial.com
# Must equal PUBLIC_LEAD_API_KEY in backend/.env
VITE_PUBLIC_API_KEY=change-me-website-key
