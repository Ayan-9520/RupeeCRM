DATABASE_URL=postgresql+psycopg://rupeedial:rupeedial@db:5432/rupeedial_crm
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Same value on the website as CRM_PUBLIC_API_KEY. Campaign posts use this key too.
PUBLIC_LEAD_API_KEY=change-me-website-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_EMAIL=admin@rupeedial.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=RupeeDial Admin

# Forgot-password emails via a Hostinger mailbox (hPanel > Emails). Leave SMTP_PASSWORD empty to disable.
CRM_PUBLIC_URL=https://crm.rupeedial.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@rupeedial.com
SMTP_PASSWORD=
SMTP_FROM=no-reply@rupeedial.com
SMTP_FROM_NAME=RupeeDial

# Customer documents. Leave the S3 values empty to keep files on this server.
# When bucket, access key, and secret are set, new files go to that private bucket.
# The CRM still checks login before anyone can download. The bucket is not public.
# Endpoint is only for Cloudflare R2 or MinIO. Amazon S3 can leave it empty. Region ap-south-1 is Mumbai.
DOCUMENT_STORAGE_DIR=
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
DOCUMENT_S3_REGION=ap-south-1
DOCUMENT_S3_ENDPOINT=

# Leave empty until Razorpay is connected. Payments still record when an admin activates a plan.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Click-to-call. Leave empty until the calling account is ready.
# The provider rings the caller first, then the customer. Recordings stay on the provider.
# TELEPHONY_CLICK_URL is the provider's click-to-call endpoint.
# TELEPHONY_API_KEY is sent as Authorization: Bearer.
# TELEPHONY_VIRTUAL_NUMBER is the number the customer sees.
TELEPHONY_CLICK_URL=
TELEPHONY_API_KEY=
TELEPHONY_VIRTUAL_NUMBER=
